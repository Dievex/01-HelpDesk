// Traduce el Modelo de Dominio (docs/01-fase-inicio/modelo-dominio/diagrama-clases.md) y el
// Modelo de Análisis/Diseño (docs/02-fase-elaboracion/modelo-analisis-diseno/) a un esquema real.
// Decisiones y su porqué: docs/03-fase-construccion/decisiones-tecnicas.md

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Rol {
  SOLICITANTE
  AGENTE
  SUPERVISOR
  ADMINISTRADOR
}

// Solo aplica cuando rol = AGENTE o SUPERVISOR.
enum NivelAgente {
  N1
  N2
  N3
}

// Transiciones válidas: docs/01-fase-inicio/modelo-dominio/diagrama-estados.md
enum EstadoTicket {
  ABIERTO
  ASIGNADO
  EN_PROGRESO
  ESCALADO
  RESUELTO
  REABIERTO
  CERRADO
}

enum Visibilidad {
  PUBLICO
  INTERNO
}

enum TipoEventoAuditoria {
  CREACION
  ASIGNACION
  REASIGNACION
  RESOLUCION
  ESCALAMIENTO
  CIERRE
  REAPERTURA
  PRIORIZACION
  VINCULACION
}

model Usuario {
  id             String       @id @default(uuid())
  nombre         String
  correo         String       @unique
  contrasenaHash String
  rol            Rol
  nivel          NivelAgente?

  equipo   Equipo? @relation(fields: [equipoId], references: [id], onDelete: SetNull)
  equipoId String?

  ticketsReportados Ticket[] @relation("TicketSolicitante")
  ticketsAtendidos  Ticket[] @relation("TicketAgente")

  comentarios      Comentario[]
  adjuntos         Adjunto[]
  eventosAuditoria EventoAuditoria[]
  articulos        ArticuloConocimiento[]
  notificaciones   Notificacion[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Equipo {
  id     String @id @default(uuid())
  nombre String @unique

  miembros   Usuario[]
  categorias Categoria[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Categoria {
  id     String @id @default(uuid())
  nombre String @unique

  equipo   Equipo? @relation(fields: [equipoId], references: [id], onDelete: SetNull)
  equipoId String?

  tickets Ticket[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Prioridad {
  id     String @id @default(uuid())
  nombre String @unique

  sla     SLA?
  tickets Ticket[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model SLA {
  id                     String @id @default(uuid())
  tiempoPrimeraRespuesta Int // minutos
  tiempoResolucion       Int // minutos

  prioridad   Prioridad @relation(fields: [prioridadId], references: [id], onDelete: Cascade)
  prioridadId String    @unique
}

model Ticket {
  id                    String       @id @default(uuid())
  titulo                String
  descripcion           String
  estado                EstadoTicket @default(ABIERTO)
  fechaCreacion         DateTime     @default(now())
  fechaResolucion       DateTime?
  prioridadConfirmada   Boolean      @default(false)
  fechaLimiteReapertura DateTime?

  solicitante   Usuario @relation("TicketSolicitante", fields: [solicitanteId], references: [id])
  solicitanteId String

  agente   Usuario? @relation("TicketAgente", fields: [agenteId], references: [id])
  agenteId String?

  categoria   Categoria @relation(fields: [categoriaId], references: [id])
  categoriaId String

  prioridad   Prioridad @relation(fields: [prioridadId], references: [id])
  prioridadId String

  comentarios      Comentario[]
  adjuntos         Adjunto[]
  eventosAuditoria EventoAuditoria[]
  articulos        ArticuloConocimiento[] // "se resuelve con"

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Comentario {
  id    String   @id @default(uuid())
  texto String
  fecha DateTime @default(now())

  ticket   Ticket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  ticketId String

  autor   Usuario @relation(fields: [autorId], references: [id])
  autorId String
}

model Adjunto {
  id            String   @id @default(uuid())
  nombreArchivo String
  fecha         DateTime @default(now())

  ticket   Ticket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  ticketId String

  autor   Usuario @relation(fields: [autorId], references: [id])
  autorId String
}

model EventoAuditoria {
  id         String              @id @default(uuid())
  tipoEvento TipoEventoAuditoria
  fecha      DateTime            @default(now())

  ticket   Ticket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  ticketId String

  autor   Usuario? @relation(fields: [autorId], references: [id]) // null si lo dispara el Sistema
  autorId String?

  notificaciones Notificacion[]
}

model ArticuloConocimiento {
  id          String      @id @default(uuid())
  titulo      String
  contenido   String
  visibilidad Visibilidad

  autor   Usuario @relation(fields: [autorId], references: [id])
  autorId String

  tickets Ticket[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Notificacion {
  id         String   @id @default(uuid())
  mensaje    String
  fechaEnvio DateTime @default(now())
  leida      Boolean  @default(false)

  destinatario   Usuario @relation(fields: [destinatarioId], references: [id])
  destinatarioId String

  evento   EventoAuditoria? @relation(fields: [eventoId], references: [id])
  eventoId String?
}
