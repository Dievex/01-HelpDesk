# Copia este archivo a .env (gitignored) para un despliegue de PRODUCCIÓN.
# Manual completo: docs/04-fase-transicion/manual-instalacion.md
#
# Diferencia clave con .env.example (desarrollo): todos los valores marcados
# "changeme" de ahí son inseguros a propósito para no frenar el desarrollo local,
# pero acá son obligatorios de cambiar -- ver el checklist de hardening del manual.

# Postgres (usado por el contenedor "db")
POSTGRES_USER=helpdesk
# Generar uno real, no reutilizar el de desarrollo: openssl rand -base64 24
POSTGRES_PASSWORD=

POSTGRES_DB=helpdesk

# Cadena de conexión de Prisma -- host "db" es el nombre del servicio en docker
# compose, solo resuelve dentro de la red de Docker Compose. Debe usar el mismo
# POSTGRES_USER/POSTGRES_PASSWORD/POSTGRES_DB de arriba.
DATABASE_URL=postgresql://helpdesk:CAMBIAR@db:5432/helpdesk

# Auth -- generar un secreto real, nunca reutilizar el de desarrollo:
#   openssl rand -base64 48
JWT_SECRET=

# App
PORT=3000
# Plazo de Reapertura (Resuelto -> Cerrado automático si el Solicitante no responde).
REOPEN_GRACE_DAYS=7

# Adjuntos de Ticket (UC-42) -- ruta del volumen de Docker, tamaño máximo y lista
# blanca de tipos permitidos. UPLOADS_DIR debe coincidir con el volumen "uploads"
# montado en docker-compose.prod.yml.
UPLOADS_DIR=/app/uploads
ADJUNTO_TAMANO_MAX_MB=10
ADJUNTO_TIPOS_PERMITIDOS=image/png,image/jpeg,image/gif,application/pdf,text/plain

# Seed -- credenciales del Administrador inicial. Usar una contraseña real (no
# "admin123") y cambiarla desde Editar Usuario apenas se hace el primer login;
# no hay un segundo mecanismo para forzar el cambio.
ADMIN_SEED_EMAIL=admin@helpdesk.local
ADMIN_SEED_PASSWORD=

# Reverse proxy (Caddy) -- dominio público del despliegue, con DNS ya apuntando
# a esta máquina antes de levantar "caddy" (si no, falla la emisión del
# certificado HTTPS). Sin subrutas ni protocolo, solo el host.
DOMAIN=helpdesk.ejemplo.com
