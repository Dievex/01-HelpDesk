@startuml UC32-ver-prioridad
hide empty description

state "PRIORIDAD_EXISTENTE" as Pre
state "verPrioridad()" as UC {
  [*] --> fin
  fin --> [*]
}
state "DETALLE_VISIBLE" as Post

Pre --> UC : <b>Administrador</b> abre una Prioridad del listado
UC --> Post : <b>Sistema</b> muestra la Prioridad y su SLA
@enduml
