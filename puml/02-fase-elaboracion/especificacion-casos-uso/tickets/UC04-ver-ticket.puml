@startuml UC04-ver-ticket
hide empty description

state "EN_EL_SISTEMA" as Pre
state "verTicket()" as UC {
  [*] --> fin
  fin --> [*]
}
state "DETALLE_VISIBLE" as Post

Pre --> UC : <b>Actor</b> abre un ticket desde un listado
UC --> Post : <b>Sistema</b> muestra datos + comentarios + adjuntos + auditoría
@enduml
