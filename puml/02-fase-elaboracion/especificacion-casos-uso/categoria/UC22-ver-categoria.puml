@startuml UC22-ver-categoria
hide empty description

state "CATEGORIA_EXISTENTE" as Pre
state "verCategoria()" as UC {
  [*] --> fin
  fin --> [*]
}
state "DETALLE_VISIBLE" as Post

Pre --> UC : <b>Administrador</b> abre una Categoría del listado
UC --> Post : <b>Sistema</b> muestra la Categoría y su Equipo
@enduml
