# Copia este archivo a .env (gitignored) y ajusta lo que haga falta.
# El mismo .env sirve para docker-compose y para Prisma.

# Postgres (usado por el contenedor "db")
POSTGRES_USER=helpdesk
POSTGRES_PASSWORD=changeme
POSTGRES_DB=helpdesk

# Cadena de conexión de Prisma -- host "db" es el nombre del servicio en docker-compose,
# solo resuelve dentro de la red de Docker Compose (no desde el host).
DATABASE_URL=postgresql://helpdesk:changeme@db:5432/helpdesk

# Auth
JWT_SECRET=changeme-generar-un-secreto-real

# App
PORT=3000
# Plazo de Reapertura (Resuelto -> Cerrado automático si el Solicitante no responde).
REOPEN_GRACE_DAYS=7

# Seed (Iteración 0) -- credenciales del Administrador inicial, seguro solo para desarrollo.
ADMIN_SEED_EMAIL=admin@helpdesk.local
ADMIN_SEED_PASSWORD=admin123
